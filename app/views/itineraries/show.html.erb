<div class="itinerary">
  <div class="map"
    data-controller="map"
    data-map-center-value="[<%= @match.restaurant.longitude %>, <%= @match.restaurant.latitude %>]"
    data-map-zoom-value="15"
    data-map-route-value="<%= @route ? @route[:geometry].to_json : "null" %>">
  </div>

  <div class="itinerary__panel">
    <article class="itinerary__card">
      <header class="itinerary__head">
        <div class="itinerary__identity">
          <h1 class="itinerary__name"><%= @match.restaurant.name %></h1>
          <p class="itinerary__address"><%= @match.restaurant.address %></p>
        </div>

        <span class="itinerary__rating">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z"/>
          </svg>
          <%= @match.restaurant.google_rating || "—" %>
        </span>
      </header>

      <%# The walk in one line, from one end to the other. The two shapes are
          the ones standing on the map, so this doubles as their legend — the
          restaurant is named in the title just above, not repeated here. %>
      <p class="itinerary__legs">
        <span class="itinerary__leg">
          <svg class="itinerary__dot" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 22s7.5-6.6 7.5-12A7.5 7.5 0 0 0 4.5 10c0 5.4 7.5 12 7.5 12z"/>
            <circle cx="12" cy="10" r="2.9" fill="#fff"/>
          </svg>
          Ta position
        </span>

        <span class="itinerary__thread" aria-hidden="true"></span>

        <span class="itinerary__leg itinerary__leg--end">
          <svg class="itinerary__pin" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 22s7.5-6.6 7.5-12A7.5 7.5 0 0 0 4.5 10c0 5.4 7.5 12 7.5 12z"/>
            <circle cx="12" cy="10" r="2.9" fill="#fff"/>
          </svg>
          Le restaurant
        </span>
      </p>

      <% if @route %>
        <%# Each figure carries its label: "411 m" and "08:02" say nothing
            about which is the distance and which the arrival %>
        <dl class="itinerary__stats">
          <div class="itinerary__stat">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="13" cy="4" r="1.6"/>
              <path d="m9 21 2-4 2.5-2.5L12 9l-3 2-2 4"/>
              <path d="m14 12 2.5 2 1.5 5"/>
            </svg>
            <dt>Marche</dt>
            <dd><%= walking_time(@route[:duration]) %></dd>
          </div>

          <div class="itinerary__stat">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/>
              <circle cx="12" cy="10" r="2.6"/>
            </svg>
            <dt>Distance</dt>
            <dd><%= walking_distance(@route[:distance]) %></dd>
          </div>

          <div class="itinerary__stat itinerary__stat--arrival">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"/>
              <path d="M12 7v5l3 2"/>
            </svg>
            <dt>Arrivée</dt>
            <dd><%= arrival_time(@route[:duration]) %></dd>
          </div>
        </dl>
      <% else %>
        <%# A real state, not an afterthought: ORS answers nothing for some
            pairs of points, and the screen still has to say something useful %>
        <div class="itinerary__no-route">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 8v5"/>
            <path d="M12 16.5v.01"/>
          </svg>
          <p>
            <strong>Pas de chemin à pied</strong>
            On n'a pas trouvé d'itinéraire piéton jusqu'ici. Le restaurant reste
            sur la carte, à toi de voir.
          </p>
        </div>
      <% end %>

      <%= link_to "Retour", go_meal_match_path(@match),
                  class: "itinerary__back" %>
    </article>
  </div>
</div>

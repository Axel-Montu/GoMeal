<main class="home-page">
  <section class="home-page__content" data-controller="home-intro">

    <p class="home-page__brand">
      Go<span>Meal</span>
    </p>

    <%= inline_svg_tag "logo-gomeal.svg",
                       class: "home-page__logo",
                       aria: true,
                       title: "GoMeal",
                       data: { home_intro_target: "logo" } %>

    <p class="home-page__description"
       data-home-intro-target="description">
      <span>Trouvez le bon restaurant,</span>
      <span>au bon moment,</span>
      <span>selon vos envies et votre temps.</span>
    </p>


  </section>
  <%#
  <%= image_tag "city-line.png",
                alt: "",
                class: "home-page__illustration" %>

  <div class="home-page__actions">
    <%= render "shared/button",
               text: "Créer un compte",
               path: new_user_registration_path,
               variant: "primary" %>


    <%= render "shared/button",
               text: "Se connecter",
               path: new_user_session_path,
               variant: "secondary" %>

    <%= render "shared/button",
               text: "C'est parti!",
               path: locations_path,
               variant: "secondary" %>
  </div>
</main>

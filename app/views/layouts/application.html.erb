<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Go Meal" %></title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Go Meal">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="turbo-prefetch" content="true">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= yield :head %>

    <script>
      (function() {
        try {
          var t = localStorage.getItem("gomeal-theme");
          if (t && t !== "default") {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {}
      })();
    </script>

    <%# app/views/layouts/application.html.erb %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap" rel="stylesheet">

    <%= favicon_link_tag 'logo-gomeal.png' %>
    <%= favicon_link_tag 'logo-gomeal.svg', type: 'image/svg+xml' %>
    <%= favicon_link_tag 'logo-gomeal.png', rel: 'apple-touch-icon' %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body class="page-<%= controller_name.dasherize %>-<%= action_name.dasherize %>">
    <%= render "shared/mobile_navbar" unless controller_name == "pages" && action_name == "home" %>

    <%= render "shared/flashes" %>

    <%= yield %>
  </body>
</html>

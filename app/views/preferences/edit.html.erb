<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15/dist/nouislider.min.css">
<% end %>

<main class="preferences-edit">
  <div class="preferences-edit__glow" aria-hidden="true"></div>

  <header class="preferences-edit__header">
    <h1 class="preferences-edit__title">Mes préférences</h1>
    <p class="preferences-edit__lead">Elles décident des restaurants qu'on te propose.</p>
  </header>

  <%= simple_form_for @user,
                      url: preferences_path,
                      html: { class: "preferences-edit__form" } do |f| %>

    <section class="pref-setting"
             data-controller="time-slider"
             data-time-slider-initial-value="<%= @user.average_lunch_time_minutes || 60 %>"
             data-time-slider-min-value="30"
             data-time-slider-max-value="90"
             data-time-slider-captions-value="<%= [[45, 'Express'], [75, 'Normal'], [90, "J'ai le temps"]].to_json %>"
             data-time-slider-pips-value="<%= [30, 60, 90].to_json %>">

      <div class="pref-setting__head">
        <%# The figure lives in the slider tooltip, so the head carries the question alone %>
        <label class="pref-setting__question">Combien de temps as-tu pour déjeuner ?</label>
      </div>

      <div data-time-slider-target="slider" class="lunch-slider"></div>

      <%# The caption is a consequence of the figure, so it reads under it,
          smaller — it used to be the loudest thing on the screen %>
      <p class="pref-setting__caption" data-time-slider-target="label"></p>

      <%= f.hidden_field :average_lunch_time_minutes,
                         data: { time_slider_target: "input" } %>
    </section>

    <section class="pref-setting"
             data-controller="time-slider"
             data-time-slider-initial-value="<%= @user.max_walking_minutes || 15 %>"
             data-time-slider-min-value="0"
             data-time-slider-max-value="30"
             data-time-slider-captions-value="<%= [[5, 'Sur place'], [15, 'À deux pas'], [30, 'Un peu de marche']].to_json %>"
             data-time-slider-pips-value="<%= [0, 15, 30].to_json %>">

      <div class="pref-setting__head">
        <label class="pref-setting__question">Jusqu'où acceptes-tu de marcher ?</label>
      </div>

      <div data-time-slider-target="slider" class="lunch-slider"></div>

      <p class="pref-setting__caption" data-time-slider-target="label"></p>

      <%= f.hidden_field :max_walking_minutes,
                         data: { time_slider_target: "input" } %>
    </section>

    <section class="pref-setting"
             data-controller="budget-slider"
             data-budget-slider-initial-value="<%= @user.budget || 10 %>"
             data-budget-slider-min-value="10"
             data-budget-slider-max-value="80"
             data-budget-slider-captions-value="<%= [[10, 'Efficace 💸'], [20, 'Un bon kiff 🍲'], [30, 'Ça lâche les chevaux... 🍴'], [50, 'Repas de roi 👑'], [80, 'No limits 🤪'] ].to_json %>"
             data-budget-slider-pips-value="<%= [10, 20, 30, 40, 50, 60, 70, 80].to_json %>">

      <div class="pref-setting__head">
        <label class="pref-setting__question">Quel budget pour ton repas ?</label>
      </div>

      <div data-budget-slider-target="slider" class="lunch-slider"></div>

      <p class="pref-setting__caption" data-budget-slider-target="label"></p>

      <%= f.hidden_field :budget,
                         data: { budget_slider_target: "input" } %>
    </section>

    <%= f.submit "Enregistrer mes préférences",
                 class: "btn-go btn-go--secondary" %>

  <% end %>
</main>

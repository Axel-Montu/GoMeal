<main class="preferences-edit-page">
  <h1 class="preferences-edit-page__title">Mes préférences</h1>

  <%= simple_form_for @user,
                      url: preferences_path,
                      html: { class: "preferences-edit-page__form" } do |f| %>

    <div class="form-input-go"
         data-controller="lunch-time-slider"
         data-lunch-time-slider-initial-value="<%= @user.average_lunch_time_minutes || 60 %>">

      <label>Combien de temps as-tu pour déjeuner ?</label>

      <div data-lunch-time-slider-target="slider" class="lunch-slider"></div>

      <p class="lunch-slider-caption"
         data-lunch-time-slider-target="label"></p>

      <%= f.hidden_field :average_lunch_time_minutes,
                         data: { lunch_time_slider_target: "input" } %>
    </div>

    <%= f.submit "Enregistrer mes préférences",
                 class: "btn-go btn-go--primary" %>

  <% end %>
</main>

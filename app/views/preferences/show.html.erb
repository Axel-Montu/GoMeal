<% content_for :head do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15/dist/nouislider.min.css">
<% end %>

<main class="preferences-edit-page">
  <h1 class="preferences-edit-page__title">Mes préférences</h1>

  <%= simple_form_for @user,
                      url: preferences_path,
                      html: { class: "preferences-edit-page__form" } do |f| %>

    <details class="pref-section" open>
      <summary>Temps de pause déjeuner</summary>
      <div class="form-input-go"
           data-controller="time-slider"
           data-time-slider-initial-value="<%= @user.average_lunch_time_minutes || 60 %>"
           data-time-slider-min-value="30"
           data-time-slider-max-value="90"
           data-time-slider-captions-value="<%= [[45, 'Express'], [75, 'Normal'], [90, "J'ai le temps"]].to_json %>"
           data-time-slider-pips-value="<%= [30, 60, 90].to_json %>">

        <label>Combien de temps au total as tu pour ta pause déjeuner?</label>
        <div data-time-slider-target="slider" class="lunch-slider"></div>
        <p class="lunch-slider-caption" data-time-slider-target="label"></p>
        <%= f.hidden_field :average_lunch_time_minutes,
                           data: { time_slider_target: "input" } %>
      </div>
    </details>

    <details class="pref-section" open>
      <summary>Temps de marche max</summary>
      <div class="form-input-go"
           data-controller="time-slider"
           data-time-slider-initial-value="<%= @user.max_walking_minutes || 15 %>"
           data-time-slider-min-value="0"
           data-time-slider-max-value="30"
           data-time-slider-captions-value="<%= [[5, 'Sur place'], [15, 'À deux pas'], [30, 'Un peu de marche']].to_json %>"
           data-time-slider-pips-value="<%= [0, 15, 30].to_json %>">

        <label>Temps de marche max</label>
        <div data-time-slider-target="slider" class="lunch-slider"></div>
        <p class="lunch-slider-caption" data-time-slider-target="label"></p>
        <%= f.hidden_field :max_walking_minutes,
                           data: { time_slider_target: "input" } %>
      </div>
    </details>

    <details class="pref-section">
      <summary>Régime particulier</summary>
      <div class="cuisine-card">
        <% [["halal_restaurant", "Halal"],
            ["vegan_restaurant", "Vegan"],
            ["vegetarian_restaurant", "Végétarien"]].each do |value, label| %>
          <div class="tag-item">
            <%= check_box_tag "user[dietary_restrictions][]", value, false,
                              id: "diet_#{value}", class: "tag-selector" %>
            <%= label_tag "diet_#{value}", label %>
          </div>
        <% end %>
      </div>
    </details>

    <details class="pref-section">
      <summary>Type d'établissement</summary>
      <div class="cuisine-card">
        <% [["bakery", "Boulangerie"], ["restaurant", "Restaurant"]].each do |value, label| %>
          <div class="tag-item">
            <%= check_box_tag "user[establishment_types][]", value, false,
                              id: "type_#{value}", class: "tag-selector" %>
            <%= label_tag "type_#{value}", label %>
          </div>
        <% end %>
      </div>
    </details>

    <details class="pref-section">
      <summary>Cuisines du monde</summary>
      <div class="cuisine-card">
        <% [["acai_shop", "Açai"], ["pastry_shop", "Pâtisserie"], ["ice_cream_shop", "Glacier"]].each do |value, label| %>
          <div class="tag-item">
            <%= check_box_tag "user[world_cuisines][]", value, false,
                              id: "world_#{value}", class: "tag-selector" %>
            <%= label_tag "world_#{value}", label %>
          </div>
        <% end %>
      </div>
    </details>

    <%= f.submit "Enregistrer mes préférences",
                 class: "btn-go btn-go--primary" %>
  <% end %>
</main>

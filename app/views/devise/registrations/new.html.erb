<main class="auth-page">
  <section class="auth-card">
    <div class="auth-card__visual">
      <%= image_tag "restaurants/restaurant-interior.jpg",
                    alt: "Intérieur d’un restaurant",
                    class: "auth-card__image" %>
    </div>

    <div class="auth-card__content">
      <header class="auth-card__introduction">
        <%= link_to root_path, class: "auth-card__logo-link" do %>
          <%= inline_svg_tag "logo-gomeal.svg",
                             class: "auth-card__logo",
                             aria: true,
                             title: "GoMeal" %>
        <% end %>

        <p class="auth-card__description">
          Trouvez le bon restaurant, au bon moment,
          selon vos envies et votre temps.
        </p>
      </header>

      <%= simple_form_for(resource,
                          as: resource_name,
                          url: registration_path(resource_name),
                          html: { class: "auth-form" }) do |f| %>

        <%= f.error_notification %>

        <%= f.input :email,
                    label: "Adresse e-mail",
                    placeholder: "exemple@email.com",
                    required: false,
                    autofocus: true,
                    input_html: {
                      autocomplete: "email",
                      class: "auth-form__input"
                    } %>

        <%# The hint stays: it is the rule the field will be judged against,
            and hiding it means finding out only after a failed submit %>
        <%= f.input :password,
                    label: "Mot de passe",
                    placeholder: "Votre mot de passe",
                    required: false,
                    hint: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length),
                    input_html: {
                      autocomplete: "new-password",
                      class: "auth-form__input"
                    } %>

        <%= f.input :password_confirmation,
                    label: "Confirmez le mot de passe",
                    placeholder: "Le même, pour être sûr",
                    required: false,
                    input_html: {
                      autocomplete: "new-password",
                      class: "auth-form__input"
                    } %>

        <div class="auth-form__action">
          <%= f.button :submit,
                       "Créer mon compte",
                       class: "btn-go btn-go--primary" %>
        </div>
      <% end %>

      <div class="auth-card__registration">
        <p>Vous avez déjà un compte ?</p>

        <%= render "shared/button",
                   text: "Se connecter",
                   path: new_session_path(resource_name),
                   variant: "secondary" %>
      </div>
    </div>
  </section>
</main>

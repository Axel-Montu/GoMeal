<main class="auth-page">
  <section class="auth-card">
    <div class="auth-card__visual">
      <%= image_tag "restaurants/restaurant-interior.jpg",
                    alt: "Intérieur d’un restaurant",
                    class: "auth-card__image" %>
    </div>

    <div class="auth-card__content">
      <header class="auth-card__introduction">
        <%= link_to root_path, class: "auth-card__logo-link" do %>
          <%= inline_svg_tag "logo-gomeal.svg",
                             class: "auth-card__logo",
                             aria: true,
                             title: "GoMeal" %>
        <% end %>

        <p class="auth-card__description">
          Trouvez le bon restaurant, au bon moment,
          selon vos envies et votre temps.
        </p>
      </header>

      <%= simple_form_for(resource,
                          as: resource_name,
                          url: session_path(resource_name),
                          html: { class: "auth-form" }) do |f| %>

        <%= f.input :email,
                    label: "Adresse e-mail",
                    placeholder: "exemple@email.com",
                    required: false,
                    autofocus: true,
                    input_html: {
                      autocomplete: "email",
                      class: "auth-form__input"
                    } %>

        <%= f.input :password,
                    label: "Mot de passe",
                    placeholder: "Votre mot de passe",
                    required: false,
                    input_html: {
                      autocomplete: "current-password",
                      class: "auth-form__input"
                    } %>

        <% if devise_mapping.rememberable? %>
          <%= f.input :remember_me,
                      as: :boolean,
                      label: "Se souvenir de moi",
                      wrapper_html: {
                        class: "auth-form__remember"
                      } %>
        <% end %>

        <div class="auth-form__action">
          <%= f.button :submit,
                       "Se connecter",
                       class: "btn-go btn-go--primary" %>
        </div>
      <% end %>

      <div class="auth-card__forgot">
        <%= link_to "Mot de passe oublié ?",
                    new_password_path(resource_name) %>
      </div>

      <div class="auth-card__registration">
        <p>Vous n’avez pas encore de compte ?</p>

        <%= render "shared/button",
                   text: "Créer un compte",
                   path: new_registration_path(resource_name),
                   variant: "secondary" %>
      </div>
    </div>
  </section>
</main>

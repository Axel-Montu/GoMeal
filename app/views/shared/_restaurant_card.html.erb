<article class="restaurant-card">
  <% if local_assigns[:cover].present? %>
    <div class="restaurant-card__cover">
      <%= image_tag cover, alt: name %>
    </div>
  <% end %>
  <div class="restaurant-card__content">
    <div class="restaurant-card__header">
      <h3><%= name %></h3>

      <%# La note se lit sur la ligne de l'adresse : même ligne de base,
          calée à droite. %>
      <div class="restaurant-card__meta">
        <p><%= address %></p>

        <span class="restaurant-card__rating">
          ★ <%= rating %>
        </span>
      </div>

      <p><%= category %></p>
    </div>

    <div class="restaurant-card__stats">
      <span>🚶 <%= travel_time %></span>
      <span>🍽️ <%= meal_time %></span>
      <span>⏱️ <%= total_time %></span>
    </div>
  </div>
</article>

<article class="restaurant-card">
  <div class="restaurant-card__content">
    <div class="restaurant-card__header">
      <div>
        <h3><%= name %></h3>
        <p><%= address %></p>
        <p><%= category %></p>
      </div>

      <span class="restaurant-card__rating">
        ★ <%= rating %>
      </span>
    </div>

    <div class="restaurant-card__stats">
      <span>🚶 <span data-geolocation-target="travelTime"><%= travel_time %></span></span>
      <span>🍽️ <span data-geolocation-target="mealTime"><%= meal_time %></span></span>
      <span>⏱️ <span data-geolocation-target="totalTime"><%= total_time %></span></span>
    </div>
  </div>
</article>

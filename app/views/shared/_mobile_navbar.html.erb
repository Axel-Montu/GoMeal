<nav class="mobile-navbar" data-controller="nav-menu">
  <% case %>
  <% when controller_name == "locations" %>
    <%= link_to root_path, class: "mobile-navbar__button" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
  <% when controller_name == "preferences" %>
    <%= link_to root_path, class: "mobile-navbar__button" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
  <% when controller_name == "go_meal_matches" && action_name == "index" %>
    <%= link_to edit_preferences_path, class: "mobile-navbar__button" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
  <% when controller_name == "go_meal_matches" && action_name == "show" %>
    <%= link_to go_meal_matches_path, class: "mobile-navbar__button" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
  <% when controller_name == "itineraries" %>
    <%= link_to go_meal_matches_path, class: "mobile-navbar__button" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
  <% when controller_name == "reviews" %>
    <%= link_to go_meal_matches_path, class: "mobile-navbar__button" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
  <% end %>

  <p class="mobile-navbar__logo">
    Go<span>Meal</span>
  </p>

  <div class="mobile-navbar__actions">
    <button type="button"
            class="mobile-navbar__menu-trigger"
            data-action="click->nav-menu#toggle"
            aria-label="Ouvrir le menu">
      <i class="fa-solid fa-ellipsis-vertical"></i>
    </button>

    <div class="mobile-navbar__panel" data-nav-menu-target="panel">
      <% if user_signed_in? && controller_name != "preferences" %>
        <%= link_to "Préférences", preferences_path, class: "mobile-navbar__panel-item" %>
      <% end %>

      <%= link_to "Avis", reviews_path, class: "mobile-navbar__panel-item" %>

      <div class="theme-dropdown" data-controller="theme">
        <button type="button"
                class="mobile-navbar__panel-item"
                data-action="click->theme#toggleMenu">
          Themes
          <i class="fa-solid fa-chevron-down"></i>
        </button>

        <ul class="theme-dropdown__menu" data-theme-target="menu">
          <li>
            <button type="button"
                    class="theme-dropdown__item"
                    data-theme-name="default"
                    data-action="click->theme#select">
              Default
            </button>
          </li>
          <li>
            <button type="button"
                    class="theme-dropdown__item"
                    data-theme-name="vintage"
                    data-action="click->theme#select">
              Vintage
            </button>
          </li>
          <li>
            <button type="button"
                    class="theme-dropdown__item"
                    data-theme-name="coral"
                    data-action="click->theme#select">
              Coral
            </button>
          </li>
          <li>
            <button type="button"
                    class="theme-dropdown__item"
                    data-theme-name="avocat"
                    data-action="click->theme#select">
              Avocat
            </button>
          </li>
          <li>
            <button type="button"
                    class="theme-dropdown__item"
                    data-theme-name="brique"
                    data-action="click->theme#select">
              Brique
            </button>
          </li>
          <li>
            <button type="button"
                    class="theme-dropdown__item"
                    data-theme-name="mono"
                    data-action="click->theme#select">
              Noir & Blanc
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>

<main class="match-show">
  <%# 1. The match is the event: it gets said before anything is listed %>
  <header class="match-show__header">
    <p class="match-show__eyebrow">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
      Ça matche
    </p>

    <h1 class="match-show__title">Ton déjeuner est trouvé</h1>

    <% if @match.go_meal_score.present? %>
      <% score = @match.go_meal_score.clamp(0, 100) %>
      <div class="match-show__score" style="--score: <%= score %>" role="img"
           aria-label="Affinité <%= score %> pour cent"
           data-controller="score-ring"
           data-score-ring-score-value="<%= score %>">
        <div class="match-show__score-ring">
          <span class="match-show__score-value"
                data-score-ring-target="value"><%= score %><small>%</small></span>
        </div>
        <p class="match-show__score-label">Affinité</p>
      </div>
    <% end %>
  </header>

  <%# 2. The restaurant, with its cover photo %>
  <%= render "shared/restaurant_card",
            cover: restaurant_cover_photo(@match.restaurant),
            name: @match.restaurant.name,
            address: @match.restaurant.address,
            category: (@match.restaurant.types.first || "Restaurant").tr("_", " ").capitalize,
            rating: (@match.restaurant.google_rating || "—"),
            travel_time: @route ? walking_time(@route[:duration]) : "—",
            meal_time: @meal ? meal_time(@meal) : "—",
            total_time: (@route && @meal) ? total_time(@route[:duration], @meal) : "—" %>

  <%# 3. One block, or none. A review once it exists, the call to rate while
         the lunch is over and unanswered, nothing the rest of the time %>
  <% if @review.present? %>
    <%= render "reviews/review", review: @review, match: @match %>
  <% elsif @match.awaiting_review?(current_location: @current_location) %>
    <%= render "go_meal_matches/rate_prompt", match: @match %>
  <% end %>

  <%# 4. Going there stays possible in every state: a rated lunch can be
         walked to again. The way back to the other matches sits under it,
         so the screen is never a dead end %>
  <div class="match-show__actions">
    <%= link_to "Y aller", go_meal_match_itinerary_path(@match),
                class: "btn-go btn-go--primary" %>

    <%= link_to "Voir mes autres matchs", @back_path,
                class: "btn-go btn-go--secondary" %>
  </div>
</main>
